# 의존성·외부 도구 클론
node_modules
/tools
__pycache__/
.hyperframes/
.DS_Store
# 회차 결과·중간 산출물(레포에 올리지 않는다)
episodes/*/out/
episodes/*/scene.json
episodes/*/scene.js
# 회차 폴더의 kit·fonts·lib·index.html 은 engine/setup_episode.py(build.py가 부른다)가 만든다. Windows에서 git 링크가 깨져서 올리지 않는다
# index.html을 회차용으로 고쳐 올릴 때만 git add -f
episodes/*/kit
episodes/*/fonts
episodes/*/lib
episodes/*/index.html
*.mp4
*.mov
# 생성 원본·승인 모음(승인·등록된 프리미티브만 kit/ 에 올린다)
kit/gen/out/
review/
# wav는 올리지 않는다. 정식 음원은 GitHub Release 「music-v1」 팩(engine/fetch_kit.py가 받음)
*.wav
